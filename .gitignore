# Dependencias y compilaciones (los lockfiles SI se versionan).
**/node_modules/
**/vendor/
**/dist/
**/dist-ssr/
**/www/
**/.angular/
**/out-tsc/
**/coverage/
**/.vite/
**/.cache/
**/.parcel-cache/
**/.phpunit.cache/
**/.phpunit.result.cache
**/.eslintcache
**/*.tsbuildinfo
**/__pycache__/
**/*.py[cod]
**/*.timestamp-*.mjs

# Configuracion privada. Conservar exclusivamente ejemplos sin secretos.
.env
.env.*
!.env.example
!.env.*.example
**/auth.json
**/.npmrc
**/.netrc
**/.aws/
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/local.properties

# Logs, bases locales y copias de datos. El esquema se comparte con migraciones.
**/*.log
**/logs/
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.sqlite3-*
**/*.db
**/*.db-*
**/*.sql
**/*.sql.gz
/Api-Rest/swiftsite_clean
**/*.bak
**/*.tmp
**/*.temp
**/*.local

# Laravel: contenido generado/local, conservando archivos de estructura.
/Api-Rest/bootstrap/cache/*
!/Api-Rest/bootstrap/cache/.gitignore
/Api-Rest/public/build/
/Api-Rest/public/hot
/Api-Rest/public/storage
/Api-Rest/storage/**/*
!/Api-Rest/storage/**/
!/Api-Rest/storage/**/.gitignore
/Api-Rest/Homestead.yaml
/Api-Rest/Homestead.json

# Preparacion local de Codex y perfiles de navegador: no son codigo de producto.
/Api-Rest/.admin-integration/
/Api-Rest/.ionic-fixes/
/Api-Rest/.scroll-fix/
/Api-Rest/.sprint2/
/Api-Rest/.github-prep/
**/.codex/
**/.agents/

# Sistema operativo y ajustes personales del editor.
.DS_Store
Thumbs.db
Desktop.ini
**/.idea/
**/.fleet/
**/.zed/
**/.vscode/*
!**/.vscode/extensions.json
*.suo
*.swp
*.swo

# Solo si se agrega Android/iOS en un sprint posterior: preservar su fuente.
**/android/.gradle/
**/android/build/
**/android/app/build/
**/ios/App/Pods/
**/ios/App/build/
**/*.apk
**/*.aab
**/*.ipa
